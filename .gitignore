# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db

# =========================
# Editors / IDE
# =========================
.vscode/
.idea/
*.iml
.eslintcache
/.history/

# =========================
# General logs & temps
# =========================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# =========================
# Environment files
# (Keep .env.example files)
# =========================
.env
.env.*
apps/**/.env
apps/**/.env.*
!*.example

# =========================
# Node / Web (Vite React)
# =========================
node_modules/
dist/
build/
out/
coverage/
apps/web/node_modules/
apps/web/dist/
apps/web/.vite/

# If you use a single root lockfile, ignore nested ones:
apps/*/package-lock.json
apps/*/yarn.lock
apps/*/pnpm-lock.yaml

# =========================
# React Native / Expo
# =========================
apps/mobile/node_modules/
apps/mobile/.expo/
apps/mobile/.expo-shared/
apps/mobile/web-build/
# If you use Expo prebuild, these will be generated; usually ignored:
apps/mobile/android/
apps/mobile/ios/

# =========================
# Python (FastAPI service)
# =========================
__pycache__/
*.py[cod]
*.so
*.pyd
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/
ENV/
apps/ai-service/.venv/
apps/ai-service/.pytest_cache/
apps/ai-service/__pycache__/

# =========================
# Java / Spring Boot (Maven)
# =========================
apps/backend/target/
apps/backend/.mvn/wrapper/maven-wrapper.jar
# ↑ Eğer Maven wrapper jar’ını commit etmek istiyorsan, üst satırı sil.

# =========================
# Docker / DB artifacts
# =========================
infra/db/data/
infra/docker/**/data/
*.pid

# =========================
# Misc build tools
# =========================
*.gz
*.zip
*.tar
*.tgz
